---
import {
  "moonbitlang/core/async",
  "moonbitlang/core/env",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/shell",
  "moonbitlang/core/async/stdio",
}
---

///|
async fn main {
  let code = run_case()
  @env.exit(code)
}

///|
async fn run_case() -> Int32 {
  let root = @fs.realpath("../..")
  let temporary = @fs.tmpdir(prefix="openseek-testcli-")
  defer @fs.rmdir(temporary, recursive=true)
  let dir = @fs.realpath(temporary)
  let args = @env.args()[1:].to_owned()
  @fs.write_text(
    "\{dir}/sample.mbt",
    "first\nselected\nlast\n",
    create_mode=CreateOrTruncate,
  )
  @fs.write_text("\{dir}/note.txt", "whole file", create_mode=CreateOrTruncate)
  @fs.write_text("\{dir}/empty.txt", "", create_mode=CreateOrTruncate)
  @fs.mkdir("\{dir}/dir")
  if args.contains("log:12") {
    @fs.write_text("\{dir}/log:12", "kept", create_mode=CreateOrTruncate)
  }
  @fs.write_text("\{dir}/--weird", "dash", create_mode=CreateOrTruncate)
  let read = "\{root}/share/workflow/read.mbtx"
  let result = @shell.Cmd(
    "moon",
    ["run", "--quiet", "--target", "wasm", read, "--", ..args],
    cwd=dir,
    env={ "MOON_WORK": "off" },
    stdin=Text(""),
  ).output()
  @stdio.stdout.text.write(result.stdout())
  @stdio.stderr.text.write(result.stderr())
  result.exit_code()
}
