---
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/shell",
  "moonbitlang/core/async/stdio",
}
---

///|
async fn main {
  let root = @fs.realpath("../..")
  let temporary = @fs.tmpdir(prefix="openseek-testcli-")
  defer @fs.rmdir(temporary, recursive=true)
  let dir = @fs.realpath(temporary)
  let project = "\{dir}/session/scratch/app"
  @fs.mkdir(project, recursive=true)
  let output = "\{dir}/session/scratch/artifact"
  let manifest =
    #|name = "example/artifact"
    #|version = "0.0.0"
  let package_config =
    #|pkgtype(kind: "executable")
    #|options(link: { "js": { "format": "iife" } })
  let source =
    #|fn main { println("The application has loaded") }
  @fs.write_text("\{project}/moon.mod", manifest, create_mode=CreateOrTruncate)
  @fs.write_text(
    "\{project}/moon.pkg",
    package_config,
    create_mode=CreateOrTruncate,
  )
  @fs.write_text("\{project}/main.mbt", source, create_mode=CreateOrTruncate)
  let builder = "\{root}/share/artifact/build.mbtx"

  let original_page = publish(builder, project, output, dir, "chart-v1.html")
  let template =
    #|<!doctype html><html><head><style>.answer{padding:1rem}</style></head>
    #|<body><div id="app"></div><!-- openseek:script --></body></html>
  let source =
    #|fn main { println("</ScRiPt><p>Still application data</p>") }
  @fs.write_text(
    "\{project}/index.html",
    template,
    create_mode=CreateOrTruncate,
  )
  @fs.write_text("\{project}/main.mbt", source, create_mode=CreateOrTruncate)

  let page = publish(builder, project, output, dir, "answer-v2.html")
  println("has_mount=\{page.contains("<div id=\"app\"></div><script>")}")
  println("has_styles=\{page.contains(".answer{padding:1rem}")}")
  println("script_tag_escaped=\{page.contains("<\\/ScRiPt>")}")
  println("marker_remaining=\{page.contains("<!-- openseek:script -->")}")

  let restored = "\{dir}/restored-app"
  copy_tree("\{output}/answer-v2.html.source", restored)
  @fs.rmdir(project, recursive=true)
  let result = @shell.Cmd(
    "moon",
    [
      "run", "--quiet", "--target", "wasm", builder, "--", restored, output, "answer-v3.html",
    ],
    cwd=dir,
    env={ "MOON_WORK": "off" },
    stdin=Text(""),
  ).output()
  println("exit=\{result.exit_code()}")
  @stdio.stdout.text.write(result.stdout())
  println("restored_page_exists=\{@fs.exists("\{output}/answer-v3.html")}")
  println(
    "original_page_preserved=\{@fs.read_text("\{output}/chart-v1.html") == original_page}",
  )
}

///|
async fn copy_tree(source : String, destination : String) -> Unit {
  @fs.mkdir(destination, recursive=true)
  for name in @fs.readdir(source, include_hidden=true) {
    let src = "\{source}/\{name}"
    let dest = "\{destination}/\{name}"
    if @fs.kind(src) is Directory {
      copy_tree(src, dest)
    } else {
      @fs.write_binary(dest, @fs.read_binary(src), create_mode=CreateNew)
    }
  }
}

///|
async fn publish(
  builder : String,
  project : String,
  output : String,
  dir : String,
  name : String,
) -> String {
  let result = @shell.Cmd(
    "moon",
    ["run", "--quiet", "--target", "wasm", builder, "--", project, output, name],
    cwd=dir,
    env={ "MOON_WORK": "off" },
    stdin=Text(""),
  ).output()
  println("exit=\{result.exit_code()}")
  @stdio.stdout.text.write(result.stdout())
  @fs.read_text("\{output}/\{name}")
}
