---
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/shell",
  "moonbitlang/core/async/stdio",
}
---

///|
async fn main {
  let run = ["run", "--quiet", "--target", "wasm", @fs.realpath("../.."), "--"]
  let dir = @fs.realpath(@fs.tmpdir(prefix="openseek-testcli-"))
  defer @fs.rmdir(dir, recursive=true)
  let base = ["run", "--no-session", "--dir", "\{dir}/ws"]
  let json = [..base, "--input-format", "json"]
  let result_args = ["--result-file", "\{dir}/result.json"]
  let result = @shell.Cmd(
    "moon",
    [..run, ..json, "--kind", "echo", ..result_args],
    cwd=dir,
    env={ "MOON_WORK": "off" },
    stdin=Text(
      (
        #|{"version":1,"input":"hi"}
      ),
    ),
  ).output()
  println("exit \{result.exit_code()}")
  @stdio.stdout.text.write(@fs.read_text("\{dir}/result.json"))
  let result = @shell.Cmd(
    "moon",
    [..run, ..json, "--kind", "explore", ..result_args],
    cwd=dir,
    env={ "MOON_WORK": "off" },
    stdin=Text(
      (
        #|{"version":1,"kind":"echo","input":"hi"}
      ),
    ),
  ).output()
  @stdio.stdout.text.write(result.stderr())
  println("exit \{result.exit_code()}")
  @stdio.stdout.text.write(@fs.read_text("\{dir}/result.json"))
}
