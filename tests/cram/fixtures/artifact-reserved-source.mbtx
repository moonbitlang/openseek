---
import {
  "moonbitlang/core/async/stdio",
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/shell",
}
---

///|
async fn main {
  let root = @fs.realpath("../..")
  let dir = @fs.realpath(@fs.tmpdir(prefix="openseek-testcli-"))
  defer @fs.rmdir(dir, recursive=true)
  let project = @fs.realpath("fixtures/artifact-app")
  let output = "\{dir}/session/scratch/artifact"
  let builder = "\{root}/share/artifact/build.mbtx"

  @fs.mkdir("\{output}/reserved.html.source", recursive=true)
  let failure = @shell.Cmd(
    "moon",
    [
      "run", "--quiet", "--target", "wasm", builder, "--", project, output, "reserved.html",
    ],
    cwd=dir,
    env={ "MOON_WORK": "off" },
  ).output()
  println("exit=\{failure.exit_code()}")
  @stdio.stdout.text.write(failure.stdout())
  @stdio.stdout.text.write(failure.stderr())
  println("html_exists=\{@fs.exists("\{output}/reserved.html")}")
  println(
    "source_directory_preserved=\{@fs.kind("\{output}/reserved.html.source") is Directory}",
  )
}
