---
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/shell",
  "moonbitlang/core/async/stdio",
}
---

///|
async fn main {
  let engine = @fs.realpath("../..")
  let temporary = @fs.tmpdir(prefix="openseek-testcli-")
  defer @fs.rmdir(temporary, recursive=true)
  let dir = @fs.realpath(temporary)
  for name in ["first", "second"] {
    @fs.write_text(
      "\{dir}/\{name}.json",
      "{\"mcpServers\":{}}",
      create_mode=CreateOrTruncate,
    )
  }
  let result = @shell.Cmd(
    "moon",
    [
      "run", "--quiet", "--target", "wasm", engine, "--", "mcp", "--mcp-config",
      "first.json", "--mcp-config=", "--mcp-config=second.json",
    ],
    cwd=dir,
    env={ "OPENSEEK_MCP_CONFIG": "missing.json", "MOON_WORK": "off" },
    stdin=Text(""),
  ).output()
  println("exit=\{result.exit_code()}")
  @stdio.stdout.text.write(result.stdout())
}
