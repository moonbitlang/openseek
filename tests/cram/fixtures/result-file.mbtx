---
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/json",
  "moonbitlang/core/path",
  "moonbitlang/core/async/process",
  "moonbitlang/core/async/shell",
  "moonbitlang/core/async/stdio",
}
---

///|
async fn main {
  let root = @fs.realpath("../..")
  let temporary = @fs.tmpdir(prefix="openseek-testcli-")
  defer @fs.rmdir(temporary, recursive=true)
  let dir = @fs.realpath(temporary)
  let engine = build(root)
  let path = "\{dir}/result.json"
  @fs.write_text(path, "stale\n", create_mode=CreateNew)
  let environment = {
    "DEEPSEEK": "",
    "KIMI": "",
    "OPENSEEK_MODEL": "deepseek-flash",
    "MOON_WORK": "off",
  }
  let result = @shell.Cmd(
    "moonrun",
    [
      engine,
      "--",
      "run",
      "--no-session",
      "--dir",
      "\{dir}/ws",
      "--result-file",
      path,
      "task",
    ],
    cwd=dir,
    env=environment,
  ).output()
  println("exit \{result.exit_code()}")
  @stdio.stdout.text.write(@fs.read_text(path))
  @fs.remove(path)

  // The result must still be written when reporting the error to stderr fails.
  let (reader, broken_stderr) = @process.pipe()
  reader.close()
  defer broken_stderr.close()
  let result = @process.run(
    "moonrun",
    [
      engine,
      "--",
      "run",
      "--no-session",
      "--dir",
      "\{dir}/ws2",
      "--result-file",
      path,
      "task",
    ],
    cwd=dir,
    extra_env=environment,
    stdin=Empty,
    stdout=Discard,
    stderr=Shared(broken_stderr),
  )
  println("exit \{result.exit_code}")
  @stdio.stdout.text.write(@fs.read_text(path))
}

///|
async fn build(path : String) -> String {
  let cwd = if @fs.kind(path) is Directory {
    path
  } else {
    @path.Path(path).dirname().to_string()
  }
  let result = @shell.Cmd(
    "moon",
    ["build", "--target", "wasm", "--output-json", path],
    cwd~,
  ).output()
  result.check()
  for line in result.stdout().split("\n") {
    if !line.is_empty() &&
      @json.parse(line)
      is { "$message_type": String("artifact"), "path": String(wasm), .. } {
      return wasm
    }
  }
  fail("moon build returned no executable artifact")
}
