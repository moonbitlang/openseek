---
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/json",
  "moonbitlang/core/path",
  "moonbitlang/core/async/shell",
  "moonbitlang/core/async/stdio",
}
---

///|
async fn main {
  let root = @fs.realpath("../..")
  let temporary = @fs.tmpdir(prefix="openseek-testcli-")
  defer @fs.rmdir(temporary, recursive=true)
  let dir = @fs.realpath(temporary)
  let engine = build(root)
  let base = ["run", "--no-session", "--dir", "\{dir}/ws"]
  let json = [..base, "--input-format", "json"]
  let echo =
    #|{"version":1,"kind":"echo","input":0}
    #|
  @fs.mkdir("\{dir}/out")
  @fs.mkdir("\{dir}/ws")
  put("\{dir}/out/existing.json", "keep\n")
  let managed = [..json, "--cancel-on-stdin-eof"]
  let result = @shell.Cmd(
    "moonrun",
    [engine, "--", ..managed, "--dir", "/"],
    cwd=dir,
    env={ "MOON_WORK": "off" },
    stdin=Text(echo),
  ).output()
  assert_eq(result.exit_code(), 1)
  println(first_line(result.stderr()))
  let result = @shell.Cmd(
    "moonrun",
    [engine, "--", ..managed, "--mcp-config", "\{dir}/mcp.json"],
    cwd=dir,
    env={ "MOON_WORK": "off" },
    stdin=Text(echo),
  ).output()
  assert_eq(result.exit_code(), 1)
  emit(result.stderr())
  let result = @shell.Cmd(
    "moonrun",
    [engine, "--", ..managed],
    cwd=dir,
    env={ "OPENSEEK_MCP_CONFIG": "\{dir}/mcp.json", "MOON_WORK": "off" },
    stdin=Text(echo),
  ).output()
  assert_eq(result.exit_code(), 0)
  emit(result.stderr())
  let result = @shell.Cmd(
    "moonrun",
    [
      engine,
      "--",
      ..managed,
      "--result-root",
      "\{dir}/out",
      "--result-file",
      "\{dir}/elsewhere.json",
    ],
    cwd=dir,
    env={ "MOON_WORK": "off" },
    stdin=Text(echo),
  ).output()
  assert_eq(result.exit_code(), 1)
  emit(result.stderr().replace_all(old=dir, new="DIR"))
  assert_false(@fs.exists("\{dir}/elsewhere.json"))
  println("nothing written elsewhere")
  let result = @shell.Cmd(
    "moonrun",
    [
      engine,
      "--",
      ..managed,
      "--result-root",
      "\{dir}/out",
      "--result-file",
      "\{dir}/out/existing.json",
    ],
    cwd=dir,
    env={ "MOON_WORK": "off" },
    stdin=Text(echo),
  ).output()
  assert_eq(result.exit_code(), 1)
  emit(result.stderr().replace_all(old=dir, new="DIR"))
  emit(@fs.read_text("\{dir}/out/existing.json"))
  let result = @shell.Cmd(
    "moonrun",
    [
      engine,
      "--",
      ..managed,
      "--result-root",
      "\{dir}/out",
      "--result-file",
      "\{dir}/out/result.json",
    ],
    cwd=dir,
    env={ "MOON_WORK": "off" },
    stdin=Text(echo),
  ).output()
  assert_eq(result.exit_code(), 0)
  emit(@fs.read_text("\{dir}/out/result.json"))
}

///|
async fn emit(text : String) -> Unit {
  @stdio.stdout.text.write(text)
}

///|
async fn put(path : String, text : String) -> Unit {
  @fs.mkdir(
    @path.Path(path).dirname().to_string(),
    recursive=true,
    allow_exist=true,
  )
  @fs.write_text(path, text, create_mode=CreateOrTruncate)
}

///|
fn first_line(text : String) -> String {
  text.split("\n").next().unwrap_or("").to_owned()
}

///|
async fn build(path : String) -> String {
  let cwd = if @fs.kind(path) is Directory {
    path
  } else {
    @path.Path(path).dirname().to_string()
  }
  let result = @shell.Cmd(
    "moon",
    ["build", "--target", "wasm", "--output-json", path],
    cwd~,
  ).output()
  result.check()
  for line in result.stdout().split("\n") {
    if !line.is_empty() &&
      @json.parse(line)
      is { "$message_type": String("artifact"), "path": String(wasm), .. } {
      return wasm
    }
  }
  fail("moon build returned no executable artifact")
}
