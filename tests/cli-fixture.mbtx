---
import {
  "moonbitlang/core/argparse",
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/process",
  "moonbitlang/core/async/stdio",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/path",
}
---

///|
// testcli deliberately has no shell or temporary workspace. Complex CLI
// scenarios opt into this fixture runner; testcli still owns output matching.
async fn run_fixture() -> Int32 {
  let matches = @argparse.Command(
    "cli-fixture",
    options=[@argparse.OptionArg("package", long="package")],
    positionals=[
      @argparse.PositionArg("script", num_args=@argparse.ValueRange::single()),
      @argparse.PositionArg("args", num_args=@argparse.ValueRange(lower=0)),
    ],
  ).parse()
  guard matches.values is { "script": [script, ..], .. } else {
    fail("missing fixture script")
  }
  let document_dir = @fs.realpath(".")
  let script = @fs.realpath(script)
  let extra_env = { "TESTDIR": document_dir, "MOON_WORK": "off" }
  if matches.values is { "package": [package_path, ..], .. } {
    // Build in the checkout's workspace (or the staged module), before
    // disabling workspace discovery for the temporary fixture projects.
    let build = @process.run(
      "moon",
      ["build", "--target", "native", "--output-json", package_path],
      stdout=Collect,
      stderr=Stderr,
    )
    if build.exit_code != 0 {
      @stdio.stderr.write(build.stdout_binary())
      fail("fixture executable build failed")
    }
    let mut executable : String? = None
    for line in build.stdout_text().split("\n") {
      if line.is_empty() {
        continue
      }
      if @json.parse(line)
        is {
          "$message_type": String("artifact"),
          "target_backend": String("native"),
          "path": String(path),
          ..
        } {
        guard executable is None else {
          fail("expected one fixture executable")
        }
        executable = Some(path)
      }
    }
    guard executable is Some(executable) else {
      fail("build returned no native executable")
    }
    extra_env["PATH"] = @path.Path(executable).dirname().to_string() +
      @path.delimiter.to_string() +
      @env.get_env_var("PATH").unwrap_or("")
  }
  let temporary = @fs.tmpdir(prefix="openseek-testcli-")
  defer @fs.rmdir(temporary, recursive=true)
  let temporary = @fs.realpath(temporary)
  @fs.mkdir("\{temporary}/tmp")
  extra_env["TMPDIR"] = "\{temporary}/tmp"
  let shell = @env.get_env_var("TESTCLI_SHELL").unwrap_or("bash")
  let args = [script, ..matches.values.get("args").unwrap_or([])]
  let result = @process.run(
    shell,
    args[:],
    extra_env~,
    cwd=temporary,
    stdin=Empty,
    stdout=Stdout,
    stderr=Stderr,
  )
  result.exit_code
}

///|
async fn main {
  // Finish deferred cleanup before exiting with the scenario's status.
  let status = run_fixture()
  @env.exit(status)
}
