import {
  "moonbitlang/openseek/agent",
  "moonbitlang/openseek/agent_runtime",
  "moonbitlang/openseek/agent_session",
  "moonbitlang/openseek/deepseek",
  "moonbitlang/openseek/prompt",
  "moonbitlang/openseek_protocol" @protocol,
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

supported_targets = "+native"

pkgtype(kind: "executable")

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
  ],
)
