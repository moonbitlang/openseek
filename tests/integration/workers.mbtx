///|
import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/http",
  "moonbitlang/async/process",
  "moonbitlang/async/socket",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
/// The real CLI with a durable session delegates a change to a worker. One
/// local server scripts the parent AND the real worker child (it reaches the
/// server through the forwarded --api-url; it is told apart by its
/// `submit_result` tool). The worker writes `lib/b.txt` in its worktree and
/// reports; the engine commits that on the worker's branch when it ends and
/// hands it over; the parent reads where the change is from job_output,
/// takes it with plain git through mbtx (`git cherry-pick`, then deletes the
/// branch), and finishes. Afterwards
/// the checkout has the file in a merge commit and the worktree is gone.
fn tool_call(index : Int, id : String, name : String, args : Json) -> Json {
  {
    "index": index,
    "id": id,
    "type": "function",
    "function": { "name": name, "arguments": args.stringify() },
  }
}

///|
fn calls(list : Array[Json]) -> Json {
  { "tool_calls": Json::array(list) }
}

///|
fn tool_names(request : Json) -> Array[String] {
  guard request is { "tools": Array(tools), .. } else { return [] }
  tools.filter_map(tool => {
    match tool {
      { "function": { "name": String(name), .. }, .. } => Some(name)
      _ => None
    }
  })
}

///|
/// The job id the `subagent` tool announced, if it did.
fn started_job(messages : String) -> String? {
  guard messages.split("Started subagent job ").nth(1) is Some(tail) else {
    return None
  }
  tail.split(" ").next().map(id => id.to_owned())
}

///|
/// The commit and branch the end notice names, once it has.
fn handed_over(messages : String) -> (String, String)? {
  guard messages.split("its change is commit ").nth(1) is Some(tail) else {
    return None
  }
  let words = tail.split(" ").map(word => word.to_owned()).to_array()
  // "<commit> on branch <branch>...": a branch name is these characters, and
  // whatever the text puts after it is not.
  guard words is [commit, "on", "branch", branch, ..] else { return None }
  let name = String::from_iter(
    branch
    .iter()
    .take_while(c => c is ('a'..='z' | 'A'..='Z' | '0'..='9' | '/' | '-' | '_' | '.')),
  )
  Some((commit, name))
}

///|
/// The script the parent takes a worker's change with: plain git.
fn take(commit : String, branch : String) -> String {
  (
    $|import {
    $|  "moonbitlang/async",
    $|  "moonbitlang/async/shell",
    $|}
    $|
    $|async fn main {
    $|  for args in [["cherry-pick", "\{commit}"], ["branch", "-D", "\{branch}"]] {
    $|    let code = @shell.Cmd("git", args).each_line(line => println(line))
    $|    if code != 0 { fail("git failed (exit=\{"\\{code}"})") }
    $|  }
    $|  println("TAKEN-WORKER-CHANGE")
    $|}
  )
}

///|
/// The parent's moves: start the worker, wait for it, read where its change
/// is, take it, finish once it is taken.
fn parent_turn(messages : String) -> Json {
  guard started_job(messages) is Some(job) else {
    return calls([
      tool_call(0, "start", "subagent", {
        "kind": "worker",
        "input": { "task": "MARK-W add lib/b.txt containing beta" },
        "label": "add b",
        "worktree": { "name": "add-b", "allowed_paths": ["lib"] },
      }),
    ])
  }
  match handed_over(messages) {
    _ if messages.contains("TAKEN-WORKER-CHANGE\\n") =>
      calls([tool_call(0, "done", "finish", { "answer": "the worker's change is in" })])
    // job_output said what to run: take it.
    Some((commit, branch)) if messages.contains("git cherry-pick \{commit}") =>
      calls([
        tool_call(0, "take", "mbtx", {
          "description": "take the worker's change",
          "source": take(commit, branch),
        }),
      ])
    Some(_) => calls([tool_call(0, "read", "job_output", { "job_id": job })])
    None => calls([tool_call(0, "wait", "job_wait", { "job_ids": [job] })])
  }
}

///|
/// The worker's moves: write the file, then report.
fn worker_turn(messages : String) -> Json {
  if messages.contains("\"tool_call_id\"") {
    calls([
      tool_call(0, "report", "submit_result", {
        "schema_version": 1,
        "status": "done",
        "summary": "added lib/b.txt",
        "verification": "read it back",
      }),
    ])
  } else {
    calls([tool_call(0, "write", "write", { "path": "lib/b.txt", "content": "beta\n" })])
  }
}

///|
async fn git(cwd : String, args : Array[String]) -> String {
  let (reader, out) = @process.read_from_process()
  defer reader.close()
  let code = @process.run("git", args, cwd~, stdout=out, stderr=out)
  let text = reader.read_all().text()
  guard code == 0 else { fail("git \{args.join(" ")}: \{text}") }
  text
}

///|
async fn main {
  guard @env.args() is [_, executable] else {
    fail("Usage: moon run tests/integration/workers.mbtx EXE")
  }
  let executable = @fs.realpath(executable)
  let directory = @fs.realpath(@fs.tmpdir(prefix="openseek-workers-"))
  defer @fs.rmdir(directory, recursive=true)
  let store_root = directory + "/store"
  let ws = directory + "/ws"
  @fs.mkdir(ws + "/lib", recursive=true)
  @fs.write_file(ws + "/lib/a.txt", "alpha\n")
  for
    args in [
      ["init", "-q"],
      ["config", "user.email", "e2e@test"],
      ["config", "user.name", "e2e"],
      ["add", "-A"],
      ["commit", "-q", "-m", "base"],
    ] {
    ignore(git(ws, args))
  }
  let worker_requests = Ref(0)
  @async.with_timeout(240000, () => {
    @async.with_task_group(group => {
      let server = @http.Server(@socket.Addr::parse("127.0.0.1:0"))
      group.spawn_bg(no_wait=true) <| () => {
        server.run_forever(
          (_, body, conn) => {
            let request = @json.parse(body.read_all().text())
            if !(request is { "stream": True, .. }) {
              conn.send_response(200, "OK", extra_headers={
                "Content-Type": "application/json",
              })
              let response : Json = {
                "choices": [{ "message": { "content": "{\"text\":null}" } }],
              }
              conn.write(response.stringify())
              conn.end_response()
              conn.close()
              return
            }
            let messages = request.stringify()
            let delta = if tool_names(request).contains("submit_result") {
              assert_true(messages.contains("MARK-W"))
              worker_requests.val += 1
              worker_turn(messages)
            } else {
              // The parent takes a change with its own git: no tool for it.
              assert_false(tool_names(request).contains("worktree"))
              parent_turn(messages)
            }
            conn.send_response(200, "OK", extra_headers={
              "Content-Type": "text/event-stream",
            })
            let payload : Json = { "choices": [{ "delta": delta }] }
            conn.write("data: \{payload.stringify()}\n\ndata: [DONE]\n\n")
            conn.end_response()
            conn.close()
          },
          max_connections=16,
          allow_failure=false,
        )
      }
      let (reader, child_stdout) = @process.read_from_process()
      defer reader.close()
      let (errors, child_stderr) = @process.read_from_process()
      defer errors.close()
      let process = @process.spawn(
        group,
        executable,
        [
          "run", "--dir", ws, "--api-key", "test-key", "--model", "deepseek-flash",
          "--api-url", "http://127.0.0.1:\{server.addr.port()}/chat/completions",
          "--max-steps", "12", "--mcp-config", "", "--session", "parent", "--session-root",
          store_root, "Have a worker add lib/b.txt.",
        ],
        extra_env={ "OPENSEEK_RETRY_ATTEMPTS": "1" },
        stdout=child_stdout,
        stderr=child_stderr,
        cancel_handler=@process.hard_cancel(),
      )
      let stdout = group.spawn(() => reader.read_all().text())
      let stderr = group.spawn(() => errors.read_all().text())
      let code = process.wait()
      let out = stdout.wait()
      let err = stderr.wait()
      guard code == 0 else { fail("CLI exit \{code}\nstdout: \{out}\nstderr: \{err}") }
      assert_true(
        out.contains("the worker's change is in"),
        msg="stdout: \{out}\nstderr: \{err}",
      )
      server.close()
    })
  })
  assert_eq(worker_requests.val, 2)
  // The change is in the checkout as one more commit on a linear history.
  assert_eq(@fs.read_file(ws + "/lib/b.txt").text(), "beta\n")
  assert_true(git(ws, ["log", "-1", "--format=%P"]).trim().split(" ").count() == 1)
  assert_eq(git(ws, ["status", "--porcelain", "--untracked-files=no"]), "")
  // Nothing of the worker is left: the engine removed its checkout, the
  // parent its branch.
  assert_eq(git(ws, ["branch", "--list", "openseek/*"]).trim(), "")
  assert_true(
    (@fs.readdir(ws + "/.worktrees") catch { _ => [] }).is_empty(),
    msg="a worktree directory is left",
  )
  let report = @json.parse(
    @fs.read_file(store_root + "/sessions/parent-sr-1/report.json").text(),
  )
  assert_true(report is { "status": "done", .. })
  println(
    "PASS: a worker changes its own worktree; the engine commits and hands it over; the model cherry-picks it",
  )
}
