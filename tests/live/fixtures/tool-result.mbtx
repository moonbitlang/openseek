---
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/json",
  "moonbitlang/core/async/shell",
}
---

///|
async fn main {
  let engine = @fs.realpath("../..")
  let temporary = @fs.tmpdir(prefix="openseek-testcli-")
  defer @fs.rmdir(temporary, recursive=true)
  let dir = @fs.realpath(temporary)
  let request : Json = {
    "command": "prompt",
    "content": "Use the mbtx tool to run a snippet that prints exactly: openseek-cram. Then call finish with the word done.",
  }
  let result = @shell.Cmd(
    "moon",
    [
      "run", "--quiet", "--target", "wasm", engine, "--", "serve", "--model", "deepseek-flash",
      "--max-steps", "6",
    ],
    cwd=dir,
    env={ "MOON_WORK": "off" },
    stdin=Text(request.stringify() + "\n"),
  ).output()
  println("exit=\{result.exit_code()}")
  let values : Array[Json] = []
  for line in result.stdout().split("\n") {
    if !line.is_empty() {
      values.push(@json.parse(line))
    }
  }
  let mut used_mbtx = false
  let mut mbtx_output_seen = false
  for value in values {
    if value
      is {
        "event": String("tool_result"),
        "tool_name": String("mbtx"),
        "content": String(out),
        ..
      } {
      used_mbtx = true
      if out.contains("openseek-cram") {
        mbtx_output_seen = true
      }
    }
  }
  println("used_mbtx=\{used_mbtx}")
  println("mbtx_output_seen=\{mbtx_output_seen}")
}
