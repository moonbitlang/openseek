---
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/json",
  "moonbitlang/core/async/shell",
}
---

///|
async fn main {
  let engine = @fs.realpath("../..")
  let temporary = @fs.tmpdir(prefix="openseek-testcli-")
  defer @fs.rmdir(temporary, recursive=true)
  let dir = @fs.realpath(temporary)
  let request : Json = {
    "command": "prompt",
    "content": "Call the finish tool immediately with the answer DONE. Use no other tool.",
  }
  let result = @shell.Cmd(
    "moon",
    [
      "run", "--quiet", "--target", "wasm", engine, "--", "serve", "--model", "deepseek-flash",
      "--max-steps", "3",
    ],
    cwd=dir,
    env={ "MOON_WORK": "off" },
    stdin=Text(request.stringify() + "\n"),
  ).output()
  println("exit=\{result.exit_code()}")
  let values : Array[Json] = []
  for line in result.stdout().split("\n") {
    if !line.is_empty() {
      values.push(@json.parse(line))
    }
  }
  let events = Set([])
  for value in values {
    if value is { "event": String(event), .. } &&
      ["agent_step", "usage", "agent_finished"].contains(event) {
      events.add(event)
    }
  }
  println("events={" + events.iter().join(", ") + "}")
}
