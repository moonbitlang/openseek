import {
  "moonbitlang/editor/base/common" @base_common,
  "moonbitlang/editor/language",
  "moonbitlang/editor/shell/remote_protocol",
  "moonbitlang/editor-server/server",
  "moonbitlang/editor/viewer/common/model",
  "moonbitlang/editor/shell/workspace",
  "moonbitlang/core/async",
  "moonbitlang/core/async/aqueue",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/http",
  "moonbitlang/core/async/process",
  "moonbitlang/core/async/socket",
  "moonbitlang/core/async/websocket",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

import {
  "moonbitlang/core/async",
} for "test"

supported_targets = "native+wasm"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/aqueue",
    "moonbitlang/core/async/fs",
    "moonbitlang/core/async/http",
    "moonbitlang/core/async/process",
    "moonbitlang/core/async/socket",
    "moonbitlang/core/async/websocket",
  ],
)
