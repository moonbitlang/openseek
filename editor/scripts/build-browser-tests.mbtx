import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
}

///|
async fn runner_exists(build_dir : String) -> Bool {
  @fs.exists(build_dir + "/runner/runner.js") &&
  @fs.exists(build_dir + "/runner/runner.js.map")
}

///|
/// Selects only a complete, unambiguous output layout from the workspace build.
/// If both layouts contain the runner, one may be stale, so refuse to stage
/// either instead of silently serving the wrong checkout.
async fn resolved_browser_build_dir() -> String {
  let plain = "_build/js/debug/build/tests/browser/moonbit"
  let module_dir = "_build/js/debug/build/moonbitlang/editor/tests/browser/moonbit"
  match (runner_exists(plain), runner_exists(module_dir)) {
    (true, false) => plain
    (false, true) => module_dir
    (false, false) =>
      fail("missing js artifacts for the browser test runner; run `moon build` first")
    (true, true) =>
      fail(
        "ambiguous browser runner layouts; remove stale _build js artifacts and rebuild",
      )
  }
}

///|
async fn main {
  let build_dir = resolved_browser_build_dir()
  let source_dir = build_dir + "/runner"
  let generated_js = @fs.read_file(source_dir + "/runner.js").text()
  let generated_map = @fs.read_file(source_dir + "/runner.js.map")
  let browser_tests_dir = "web/dist/browser-tests"
  if @fs.exists(browser_tests_dir) {
    @fs.rmdir(browser_tests_dir, recursive=true)
  }
  @fs.mkdir(browser_tests_dir, recursive=true)
  @fs.write_file(browser_tests_dir + "/editor-code-worker.js", @fs.read_file("web/dist/editor-code-worker.js"), create_mode=@fs.CreateOrTruncate)
  @fs.write_file(
    browser_tests_dir + "/runner.mjs",
    generated_js.replace(
      old="//# sourceMappingURL=runner.js.map",
      new="//# sourceMappingURL=runner.mjs.map",
    ),
    create_mode=@fs.CreateOrTruncate,
  )
  @fs.write_file(
    browser_tests_dir + "/runner.mjs.map",
    generated_map,
    create_mode=@fs.CreateOrTruncate,
  )
  @fs.write_file(
    browser_tests_dir + "/runner.html",
    browser_test_html(),
    create_mode=@fs.CreateOrTruncate,
  )
  println("Generated the browser test runner under web/dist/browser-tests")
}

///|
fn browser_test_html() -> String {
  (
    $|<!doctype html>
    $|<html lang="en">
    $|  <head>
    $|    <meta charset="UTF-8" />
    $|    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    $|    <base href="/">
    $|    <title>MoonBit Editor Browser Test Runner</title>
    $|    <link rel="stylesheet" href="/style.css">
    $|  </head>
    $|  <body>
    $|    <div id="app"></div>
    $|    <script type="module" src="/browser-tests/runner.mjs"></script>
    $|  </body>
    $|</html>
  )
}
