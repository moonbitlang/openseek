///|
/// A diagram family the Viewer renders to SVG. The renderers live outside
/// this package so a host can load them only when a diagram first appears.
#derive(Debug)
pub(all) enum DiagramKind {
  /// D2 source compiled by Diago (`d2` and `diago` fences).
  Diago
  /// PlantUML-style source (`uml` and `plantuml` fences).
  Uml
  /// A generated `.mbti` interface body.
  Mbti
  /// The JSON emitted by `moon tree --package --json`.
  PackageDependencies
}

///|
pub extend DiagramKind with @debug.Debug::{to_repr}

///|
/// The stable name a separately built renderer module receives.
pub fn DiagramKind::name(self : DiagramKind) -> String {
  match self {
    Diago => "diago"
    Uml => "uml"
    Mbti => "mbti"
    PackageDependencies => "package-dependencies"
  }
}

///|
/// The kind a Markdown fence language names: `d2` and `diago` are Diago,
/// `uml` and `plantuml` are UML. Other languages are not diagram fences.
pub fn DiagramKind::from_fence(language : String) -> DiagramKind? {
  match language {
    "d2" | "diago" => Some(Diago)
    "uml" | "plantuml" => Some(Uml)
    _ => None
  }
}

///|
/// Parses a name produced by `DiagramKind::name`.
pub fn DiagramKind::from_name(name : String) -> DiagramKind? {
  match name {
    "diago" => Some(Diago)
    "uml" => Some(Uml)
    "mbti" => Some(Mbti)
    "package-dependencies" => Some(PackageDependencies)
    _ => None
  }
}

///|
/// The installed renderer. It receives whether the request is still wanted,
/// so a module that is still loading can skip compiling superseded requests.
/// Without one, every diagram keeps its fallback.
let renderer : Ref[
  ((DiagramKind, String, () -> Bool, (String?) -> Unit) -> Unit)?,
] = Ref(None)

///|
/// Renders diagrams with renderers linked into the host bundle. Results are
/// delivered synchronously.
pub fn use_bundled_renderer(render : (DiagramKind, String) -> String?) -> Unit {
  renderer.val = Some((kind, source, _, on_result) => {
    on_result(render(kind, source))
  })
}

///|
/// One diagram render. After `dispose`, its result is never delivered.
struct PendingDiagram {
  wanted : Ref[Bool]
}

///|
pub fn PendingDiagram::dispose(self : PendingDiagram) -> Unit {
  self.wanted.val = false
}

///|
/// Compiles `source` and passes the SVG, or `None` when the source is invalid
/// or no renderer is available, to `on_result`. The callback may run
/// synchronously or after a module load; a caller whose target can be
/// replaced meanwhile disposes the returned render. The SVG is generated by
/// the renderer, not copied from the source.
pub fn render(
  kind : DiagramKind,
  source : String,
  on_result : (String?) -> Unit,
) -> PendingDiagram {
  let pending = { wanted: Ref(true), }
  match renderer.val {
    Some(render) =>
      render(kind, source, () => pending.wanted.val, svg => {
        if pending.wanted.val {
          on_result(svg)
        }
      })
    None => on_result(None)
  }
  pending
}
