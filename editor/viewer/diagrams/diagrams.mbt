///|
/// A diagram family the Viewer renders to SVG. The renderers live outside
/// this package so a host can load them only when a diagram first appears.
#derive(Eq, Debug)
pub(all) enum DiagramKind {
  /// D2 source compiled by Diago (`d2` and `diago` fences).
  Diago
  /// PlantUML-style source (`uml` and `plantuml` fences).
  Uml
  /// A generated `.mbti` interface body.
  Mbti
  /// The JSON emitted by `moon tree --package --json`.
  PackageDependencies
}

///|
pub extend DiagramKind with Eq::{equal, not_equal}

///|
pub extend DiagramKind with @debug.Debug::{to_repr}

///|
/// The stable name a separately built renderer module receives.
pub fn DiagramKind::name(self : DiagramKind) -> String {
  match self {
    Diago => "diago"
    Uml => "uml"
    Mbti => "mbti"
    PackageDependencies => "package-dependencies"
  }
}

///|
/// Parses a name produced by `DiagramKind::name`.
pub fn DiagramKind::from_name(name : String) -> DiagramKind? {
  match name {
    "diago" => Some(Diago)
    "uml" => Some(Uml)
    "mbti" => Some(Mbti)
    "package-dependencies" => Some(PackageDependencies)
    _ => None
  }
}

///|
/// The installed renderer. Without one, every diagram keeps its fallback.
let renderer : Ref[((DiagramKind, String, (String?) -> Unit) -> Unit)?] = Ref(
  None,
)

///|
/// Renders diagrams with renderers linked into the host bundle. Results are
/// delivered synchronously.
pub fn use_bundled_renderer(render : (DiagramKind, String) -> String?) -> Unit {
  renderer.val = Some((kind, source, on_result) => {
    on_result(render(kind, source))
  })
}

///|
/// Compiles `source` and passes the SVG, or `None` when the source is invalid
/// or no renderer is available, to `on_result`. The callback may run
/// synchronously or after a module load; callers that can be replaced in the
/// meantime must check that their target is still current. The SVG is
/// generated by the renderer, not copied from the source.
pub fn render(
  kind : DiagramKind,
  source : String,
  on_result : (String?) -> Unit,
) -> Unit {
  match renderer.val {
    Some(render) => render(kind, source, on_result)
    None => on_result(None)
  }
}
