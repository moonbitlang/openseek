import {
  "moonbitlang/openseek/agent_session",
  "moonbitlang/openseek/agent_kind",
  "moonbitlang/openseek/agent_tool",
  "moonbitlang/openseek/agent_tool/edit",
  "moonbitlang/openseek/agent_tool/multi_edit",
  "moonbitlang/openseek/agent_tool/read",
  "moonbitlang/openseek/agent_tool/remove",
  "moonbitlang/openseek/agent_tool/mbtx",
  "moonbitlang/openseek/agent_tool/write",
  "moonbitlang/openseek/agent_tool/write_scope",
  "moonbitlang/openseek/deepseek",
  "moonbitlang/core/json",
  "moonbitlang/x/path",
}

import {
  "moonbitlang/openseek/testkit/filesystem" @vfs,
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/http",
  "moonbitlang/async/socket",
} for "test"

dev_build(
  rule: "md_to_mbt_string",
  input: "worker_system_prompt.mbt.md",
  output: "generated_worker_system_prompt.mbt",
)

warnings = "+unnecessary_annotation"

supported_targets = "+wasm+native"
