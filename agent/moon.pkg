  "moonbitlang/openseek/agent_tool/multi_edit",
  "moonbitlang/openseek/agent_tool/remove",
} for "test"

warnings = "+unnecessary_annotation"

supported_targets = "+wasm+native"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
    "moonbitlang/core/async/http",
    "moonbitlang/core/async/os_error",
    "moonbitlang/core/async/process",
    "moonbitlang/core/async/socket",
  ],
)
