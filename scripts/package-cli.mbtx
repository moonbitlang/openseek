---
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.5/crypto",
}
---

///|
/// Package the already-built native CLI. Run from the repository root.
async fn main {
  guard @env.args() is [_, platform, output] else {
    fail(
      "Usage: moon run scripts/package-cli.mbtx <platform> <output-directory>",
    )
  }
  guard platform is ("linux-x64" | "linux-arm64" | "macos-arm64" | "windows-x64") else {
    fail("Unsupported platform: \{platform}")
  }
  let windows = platform == "windows-x64"
  let suffix = if windows { ".exe" } else { "" }
  let stage = @fs.tmpdir(prefix="openseek-package-")
  defer @fs.rmdir(stage, recursive=true)
  let name = "openseek-\{platform}"
  let root = "\{stage}/\{name}"
  @fs.mkdir("\{root}/bin", recursive=true)
  @fs.write_file(
    "\{root}/bin/openseek\{suffix}",
    @fs.read_file(
      "_build/native/release/build/moonbitlang/openseek/openseek.exe",
    ),
  )
  @fs.write_file(
    "\{root}/bin/openseek-app-server\{suffix}",
    @fs.read_file("_build/native/release/build/openseek_desktop/backend/server/server.exe"),
  )
  if !windows {
    @fs.chmod("\{root}/bin/openseek", 0o755)
    @fs.chmod("\{root}/bin/openseek-app-server", 0o755)
  }
  copy_tree("share", "\{root}/share")
  @fs.mkdir("\{root}/share/licenses", allow_exist=true)
  @fs.write_file(
    "\{root}/share/licenses/OpenSeek-LICENSE",
    @fs.read_file("LICENSE"),
  )
  @fs.mkdir(output, recursive=true, allow_exist=true)
  let output = @fs.realpath(output)
  let archive = "\{output}/\{name}.tar.gz"
  @shell.Cmd("tar", ["-czf", archive, "-C", stage, name]).run()
  @fs.write_file(
    "\{output}/SHA256SUMS-\{platform}",
    "\{sha256(archive)}  \{name}.tar.gz\n",
  )
  println("Packaged \{archive}")
}

///|
async fn copy_tree(source : String, destination : String) -> Unit {
  match @fs.kind(source, follow_symlink=false) {
    Directory => {
      @fs.mkdir(destination, recursive=true, allow_exist=true)
      for name in @fs.readdir(source, include_hidden=true) {
        if !(name is ("_build" | ".mooncakes")) {
          copy_tree("\{source}/\{name}", "\{destination}/\{name}")
        }
      }
    }
    Regular => @fs.write_file(destination, @fs.read_file(source))
    _ =>
      fail("Release resources must be regular files or directories: \{source}")
  }
}

///|
async fn sha256(path : String) -> String {
  let input = @fs.open(path, mode=ReadOnly)
  defer input.close()
  let hash = @crypto.SHA256::new()
  while input.read_some(max_len=65536) is Some(bytes) {
    hash.update(bytes)
  }
  @crypto.bytes_to_hex_string(hash.finalize())
}
