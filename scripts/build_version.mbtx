///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
/// Embed the release manifest's version so packaged binaries need no source files.
async fn main {
  guard @env.args() is [_, manifest, output] else {
    fail("Usage: build_version.mbtx <moon.mod> <output.mbt>")
  }
  for line in @fs.read_file(manifest).text().split("\n") {
    if line.split_once("=") is Some((key, value)) && key.trim() == "version" {
      guard @json.parse(value.trim().to_owned()) is String(version) &&
        !version.is_empty() else {
        fail("Expected a nonempty version string in \{manifest}")
      }
      @fs.write_file(
        output,
        "// Generated from moon.mod by moon dev_build. DO NOT EDIT.\n\n///|\n/// OpenSeek CLI release version of this build.\npub const Version = \{Json::string(version).stringify()}\n",
      )
      return
    }
  }
  fail("Missing version in \{manifest}")
}
