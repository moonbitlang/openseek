---
import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/http",
  "moonbitlang/async/io",
  "moonbitlang/async/socket",
  "moonbitlang/async/stdio",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/string",
}
---

///|
fn content_type(path : String) -> String {
  match path {
    [.., .. ".html"] => "text/html; charset=utf-8"
    [.., .. ".js"] | [.., .. ".mjs"] => "text/javascript; charset=utf-8"
    [.., .. ".css"] => "text/css; charset=utf-8"
    [.., .. ".json"] | [.., .. ".map"] => "application/json"
    [.., .. ".svg"] => "image/svg+xml"
    [.., .. ".png"] => "image/png"
    [.., .. ".ico"] => "image/x-icon"
    [.., .. ".woff2"] => "font/woff2"
    [.., .. ".woff"] => "font/woff"
    [.., .. ".ttf"] => "font/ttf"
    [.., .. ".wasm"] => "application/wasm"
    _ => "application/octet-stream"
  }
}

///|
fn decode_path(path : StringView) -> String raise {
  let source = @utf8.encode(path)
  let bytes : Array[Byte] = []
  for i = 0; i < source.length(); {
    if source[i] == b'%' {
      guard i + 2 < source.length() else { fail("Incomplete URL escape") }
      let hex = @utf8.decode(source[i + 1:i + 3])
      bytes.push(@string.parse_int(hex, radix=16).to_byte())
      continue i + 3
    }
    bytes.push(source[i])
    continue i + 1
  }
  @utf8.decode(Bytes::from_array(bytes))
}

///|
/// Write a complete response on a connection in passthrough mode.
///
/// `@http` buffers response bodies 1 KiB at a time, so a multi-megabyte
/// bundle took thousands of socket writes. Passthrough writes go straight to
/// the socket. Each connection serves one request and then closes.
async fn respond(
  conn : @http.ServerConnection,
  code : Int32,
  reason : String,
  content_type~ : String = "text/plain; charset=utf-8",
  body~ : Bytes = b"",
  send_body~ : Bool = true,
) -> Unit {
  conn.write(
    "HTTP/1.1 \{code} \{reason}\r\nContent-Type: \{content_type}\r\nContent-Length: \{body.length()}\r\nConnection: close\r\n\r\n",
  )
  if send_body {
    conn.write(body)
  }
}

///|
/// Loopback-only static asset server for the Desktop and session-viewer tests.
async fn main {
  guard @env.args() is [_, directory, port] else {
    fail("Usage: moon run scripts/serve-static.mbtx DIRECTORY PORT")
  }
  let root = @fs.realpath(directory).replace(old="\\", new="/")
  let server = @http.Server(@socket.Addr::parse("127.0.0.1:\{port}"))
  @stdio.stdout.write(
    "Serving \{root} on http://127.0.0.1:\{server.addr.port()}\n",
  )
  server.run_forever((request, _, conn) => {
    defer conn.close()
    conn.enter_passthrough_mode()
    if !(request.meth is (Get | Head)) {
      respond(conn, 405, "Method Not Allowed")
      return
    }
    guard request.path.split("?").head() is Some(raw_path) else {
      respond(conn, 400, "Bad Request")
      return
    }
    let path = decode_path(raw_path) catch {
      _ => {
        respond(conn, 400, "Bad Request")
        return
      }
    }
    if path.contains("\\") ||
      path.contains("\u0000") ||
      path.split("/").any(part => part == "..") {
      respond(conn, 403, "Forbidden")
      return
    }
    let mut file = root + "/" + path.trim_start(chars="/").to_owned()
    if !@fs.exists(file) {
      respond(conn, 404, "Not Found")
      return
    }
    if @fs.kind(file) == Directory {
      file += "/index.html"
    }
    if !@fs.exists(file) {
      respond(conn, 404, "Not Found")
      return
    }
    let resolved = @fs.realpath(file).replace(old="\\", new="/")
    if !resolved.has_prefix(root + "/") {
      respond(conn, 403, "Forbidden")
      return
    }
    if @fs.kind(file) != Regular {
      respond(conn, 404, "Not Found")
      return
    }
    respond(
      conn,
      200,
      "OK",
      content_type=content_type(file),
      body=@fs.read_file(file).binary(),
      send_body=request.meth is Get,
    )
  })
}
