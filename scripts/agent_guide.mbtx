---
import {
  "moonbitlang/core/async/fs",
  "moonbitlang/core/env",
}
---

///|
async fn main {
  guard @env.args() is [_, .. guides, output] && !guides.is_empty() else {
    fail("usage: agent_guide.mbtx GUIDE.md... OUTPUT")
  }
  let source = StringBuilder()
  source.write_string(
    (
      #|---
      #|import { "moonbitlang/core/env" }
      #|---
      #|
      #|fn main {
      #|  guard @env.args() is [_, id] else {
      #|    fail("agent-guide: expected exactly one guide ID")
      #|  }
      #|  let content = match id {
      #|
    ),
  )
  let root = @fs.realpath("prompt/guides").replace_all(old="\\", new="/") + "/"
  for file in guides {
    let path = @fs.realpath(file).replace_all(old="\\", new="/")
    guard path.strip_prefix(root) is Some(relative) &&
      relative.strip_suffix(".md") is Some(stem) else {
      fail("expected a Markdown file under prompt/guides/: \{file}")
    }
    let id = stem.strip_suffix("/README").unwrap_or(stem)
    source.write_string("    \{Json::string(id.to_owned()).stringify()} => (\n")
    let text = @fs.read_text(file).replace_all(old="\r\n", new="\n")
    for line in text.split("\n") {
      source.write_string("      #|\{line}\n")
    }
    source.write_string("    )\n")
  }
  source.write_string(
    (
      #|    _ => fail("agent-guide: unknown guide ID: \{id}")
      #|  }
      #|  let response : Json = { "version": 1, "id": id, "format": "markdown", "content": content }
      #|  println(response.stringify())
      #|}
      #|
    ),
  )
  @fs.write_text(output, source.to_string(), create_mode=CreateOrTruncate)
}
