import {
  "moonbitlang/openseek/agent_session/store",
  "moonbitlang/openseek/testkit/filesystem" @vfs,
  "moonbitlang/core/debug",
} for "wbtest"

import {
  "moonbitlang/openseek/agent_session",
  "moonbitlang/openseek/viz_export",
  "moonbitlang/core/async",
  "moonbitlang/core/async/http",
  "moonbitlang/core/async/socket",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/os_error",
  "moonbitlang/core/argparse",
  "moonbitlang/core/encoding/percent",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/random",
  "moonbitlang/core/string",
}

supported_targets = "native+wasm"

pkgtype(kind: "executable")

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
    "moonbitlang/core/async/http",
    "moonbitlang/core/async/os_error",
    "moonbitlang/core/async/socket",
  ],
)
