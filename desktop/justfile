set windows-shell := ["powershell.exe", "-NoLogo", "-NoProfile", "-Command"]

default:
    just --list

# Parse the shared build program and type-check every compatibility entry.
build-scripts-check:
    moon check package/internal/cli package/macos package/windows package/linux package/browser package/dev --target native
    node --check package/build.mjs
    node --test package/resources.test.mjs
    node --test package/signing.test.mjs
    node --test package/notarization.test.mjs
    node --test package/office_fonts.test.mjs
    node --test package/office_pdf.test.mjs
    node --experimental-vm-modules --test package/pdf_runtime.test.mjs
    node --check scripts/release.mjs
    node --test scripts/release.test.mjs

# The window host's package directories. Moon path arguments select single
# packages, not subtrees, and the workspace's other members are covered by the
# root gates, so list the host's own packages here.
app_packages := ". internal/cdp internal/extension"

# Check the Proton window host in its own workspace (app/moon.work). The root
# workspace leaves it out, so this is the only Moon gate that needs Proton.
app-check:
    moon -C app check {{ app_packages }} --target native --deny-warn
    moon -C app fmt --check {{ app_packages }}
    moon -C app info {{ app_packages }}

# Run the Proton window host's tests in its own workspace.
app-test:
    moon -C app test {{ app_packages }} --target native

# Build the current host's debug package through its historical Moon command.
package:
    {{ if os() == "macos" { "moon run package/macos --target native -- --no-open" } else if os() == "linux" { "moon run package/linux --target native" } else { "moon run package/windows --target native" } }}

# Build and launch the unbundled native host with proton_cli dev.
dev:
    moon run package/dev --target native

# Build the browser console and serve it on loopback against the production
# relay; see backend/internal/console_proxy/README.md (`--relay`, `--port`, `--demo`).
console-proxy *args:
    moon run package/browser --target native
    moon run backend/internal/console_proxy/main --target native -- {{ args }}

# Build the Desktop browser application and run Playwright.
test-browser:
    moon run package/browser --target native
    {{ if os() == "windows" { "npm.cmd" } else { "npm" } }} --prefix e2e test
