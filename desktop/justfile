set windows-shell := ["powershell.exe", "-NoLogo", "-NoProfile", "-Command"]

default:
    just --list

# Parse the shared build program and type-check every compatibility entry.
build-scripts-check:
    node --check backend/package/build.mjs
    node --test backend/package/resources.test.mjs
    node --check scripts/release.mjs
    node --test scripts/release.test.mjs
    moon -C backend check package/internal/cli package/macos package/windows package/linux package/browser package/dev --target native

# Build the current host's debug package through its historical Moon command.
package:
    {{ if os() == "macos" { "moon -C backend run package/macos --target native -- --no-open" } else if os() == "linux" { "moon -C backend run package/linux --target native" } else { "moon -C backend run package/windows --target native" } }}

# Build and launch the unbundled native host with proton_cli dev.
dev:
    moon -C backend run package/dev --target native

# Build the Desktop browser application and run Playwright.
test-browser:
    moon -C backend run package/browser --target native
    {{ if os() == "windows" { "npm.cmd" } else { "npm" } }} --prefix e2e test
