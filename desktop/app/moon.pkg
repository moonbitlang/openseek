import {
  "openseek_desktop/backend/resources",
  "openseek_desktop/backend/native_runtime" @host_runtime,
  "openseek_desktop/backend/engine" @engine_locator,
  "openseek_desktop/backend/host" @working_host,
  "moonbitlang/async",
  "moonbit-community/proton",
  "moonbit-community/proton_ext/notification",
  "openseek_desktop/app/internal/api",
  "openseek_desktop/backend/auth",
  "openseek_desktop/commands",
  "openseek_desktop/backend/codex",
  "openseek_desktop/app/internal/extension",
  "openseek_desktop/app/internal/host",
  "openseek_desktop/backend/mcp",
  "openseek_desktop/backend/pathx",
  "openseek_desktop/app/internal/remote",
  "openseek_desktop/backend/shellenv",
  "openseek_desktop/backend/update",
  "moonbitlang/async/process",
  "moonbitlang/core/argparse",
  "moonbitlang/core/debug",
  "moonbitlang/core/env",
  "tonyfettes/xlog",
}

warnings = "+missing_doc+test_unqualified_package+unnecessary_annotation+unnecessary_view_op+ambiguous_range_direction+unqualified_local_using"

supported_targets = "native"

pkgtype(kind: "executable")

options(
  targets: { "main.mbt": [ "native" ] },
)
