///|
import {
  "moonbitlang/async@0.19.1",
  "moonbitlang/async@0.19.1/fs",
}

///|
const FrontendBundle : String =
  "_build/js/release/build/openseek_desktop/frontend/frontend.js"

///|
const OutputPath : String = "frontend.js"

///|
async fn main raise {
  let script = @fs.read_file(FrontendBundle).text()
  @fs.write_file(OutputPath, script, create_mode=CreateOrTruncate)
  println("generated \{OutputPath} from \{FrontendBundle}")
}
