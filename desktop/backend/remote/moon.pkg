import {
  "openseek_desktop/backend/internal/browser_signin",
  "openseek_desktop/backend/uuid",
  "openseek_desktop/routes",
  "openseek_desktop/uri",
  "moonbitlang/openseek_protocol" @wire,
  "openseek_desktop/backend/api",
  "openseek_desktop/backend/auth",
  "openseek_desktop/backend/broadcast",
  "openseek_desktop/backend/endpoint",
  "openseek_desktop/backend/host",
  "openseek_desktop/backend/platform",
  "openseek_desktop/protocol",
  "openseek_desktop/backend/tunnel",
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/http",
  "moonbitlang/core/async/io",
  "moonbitlang/core/async/os_error",
  "moonbitlang/core/async/semaphore",
  "moonbitlang/core/async/socket",
  "moonbitlang/core/async/websocket",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "tonyfettes/xlog",
}

warnings = "+test_unqualified_package+unnecessary_annotation+unnecessary_view_op+ambiguous_range_direction+unqualified_local_using"

supported_targets = "+native"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
    "moonbitlang/core/async/http",
    "moonbitlang/core/async/io",
    "moonbitlang/core/async/os_error",
    "moonbitlang/core/async/semaphore",
    "moonbitlang/core/async/socket",
    "moonbitlang/core/async/websocket",
  ],
)
