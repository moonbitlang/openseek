import {
  "openseek_desktop/commands",
  "openseek_desktop/backend/engine",
  "openseek_desktop/backend/internal/development",
  "openseek_desktop/backend/endpoint",
  "openseek_desktop/backend/internal/env",
  "openseek_desktop/backend/internal/fsx",
  "openseek_desktop/backend/internal/home",
  "openseek_desktop/backend/moonbit",
  "openseek_desktop/backend/internal/opener",
  "openseek_desktop/backend/pathx",
  "openseek_desktop/backend/platform",
  "openseek_desktop/backend/internal/pattern_repair",
  "openseek_desktop/backend/internal/language",
  "openseek_desktop/backend/internal/search",
  "openseek_desktop/protocol",
  "openseek_desktop/backend/internal/skills",
  "openseek_desktop/backend/internal/files",
  "openseek_desktop/backend/internal/git",
  "openseek_desktop/backend/internal/github",
  "openseek_desktop/backend/internal/terminal",
  "openseek_desktop/backend/update",
  "openseek_desktop/backend/resources",
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/os_error",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/env" @sys,
  "moonbitlang/core/json",
  "tonyfettes/xlog",
}

warnings = "+test_unqualified_package+unnecessary_annotation+unnecessary_view_op+ambiguous_range_direction+unqualified_local_using"

supported_targets = "+native"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
    "moonbitlang/core/async/os_error",
  ],
)
