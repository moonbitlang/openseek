import {
  "moonbitlang/core/async/semaphore",
  "moonbitlang/core/async/socket",
  "moonbitlang/core/async/stdio",
  "moonbitlang/core/async/http",
  "moonbitlang/core/async/websocket",
  "moonbitlang/core/encoding/utf8",
  "openseek_desktop/protocol",
  "openseek_desktop/backend/pathx",
  "openseek_desktop/backend/internal/fsx",
  "openseek_desktop/backend/internal/home",
  "openseek_desktop/backend/uuid",
  "moonbitlang/openseek/jsonrpc",
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/process",
  "moonbitlang/core/async/os_error",
  "moonbitlang/core/json",
  "moonbitlang/core/env",
}

supported_targets = "+native+wasm"

import {
  "openseek_desktop/protocol",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/env",
} for "test"

import {
  "openseek_desktop/backend/internal/processx",
} for "wbtest"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
    "moonbitlang/core/async/http",
    "moonbitlang/core/async/os_error",
    "moonbitlang/core/async/process",
    "moonbitlang/core/async/semaphore",
    "moonbitlang/core/async/socket",
    "moonbitlang/core/async/stdio",
    "moonbitlang/core/async/websocket",
  ],
)
