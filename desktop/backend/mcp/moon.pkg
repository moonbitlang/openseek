import {
  "moonbitlang/openseek/mcp/wire",
  "openseek_desktop/backend/entropy",
  "moonbitlang/core/async",
  "moonbitlang/core/async/http",
  "moonbitlang/core/async/socket",
  "moonbitlang/core/buffer",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "tonyfettes/xlog",
}

warnings = "+test_unqualified_package+unnecessary_annotation+unnecessary_view_op+ambiguous_range_direction+unqualified_local_using"

supported_targets = "+native"

import {
  "moonbitlang/openseek/mcp/streamhttp",
  "moonbitlang/openseek/mcp/config" @mcpconfig,
} for "test"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/http",
    "moonbitlang/core/async/socket",
  ],
)
