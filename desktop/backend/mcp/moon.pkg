import {
  "moonbitlang/openseek/mcp/wire",
  "openseek_desktop/backend/entropy",
  "moonbitlang/core/async",
  "moonbitlang/core/async/http",
  "moonbitlang/core/async/io",
  "moonbitlang/core/async/socket",
  "moonbitlang/core/buffer",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "tonyfettes/xlog",
}

warnings = "+test_unqualified_package+unnecessary_annotation+unnecessary_view_op+ambiguous_range_direction+unqualified_local_using"

supported_targets = "+native"

import {
  "moonbitlang/openseek/mcp/streamhttp",
  "moonbitlang/openseek/mcp/config" @mcpconfig,
  "moonbitlang/core/async/pipe",
} for "test"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/http",
    "moonbitlang/core/async/io",
    "moonbitlang/core/async/pipe",
    "moonbitlang/core/async/socket",
  ],
)

rule(
  name: "embed_skill_markdown",
  command: ":embed -i $input -o $output --name embedded_skill_markdown --text",
)

dev_build(
  rule: "embed_skill_markdown",
  input: "skill/SKILL.md",
  output: "generated_skill_markdown.mbt",
)

rule(
  name: "embed_skill_mcp_config",
  command: ":embed -i $input -o $output --name embedded_skill_mcp_config --text",
)

dev_build(
  rule: "embed_skill_mcp_config",
  input: "skill/mcp.json",
  output: "generated_skill_mcp_config.mbt",
)
