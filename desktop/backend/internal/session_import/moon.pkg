import {
  "moonbitlang/openseek/agent_session",
  "openseek_desktop/protocol",
  "openseek_desktop/backend/uuid",
  "moonbitlang/openseek/agent_session/log",
  "moonbitlang/core/async",
  "moonbitlang/core/async/http",
  "moonbitlang/core/json",
  "moonbitlang/core/buffer",
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonbitlang/core/async/socket",
  "moonbitlang/openseek/viz_export",
} for "test"

supported_targets = "+native+wasm"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/http",
    "moonbitlang/core/async/socket",
  ],
)
