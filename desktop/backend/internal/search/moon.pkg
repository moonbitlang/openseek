import {
  "openseek_desktop/file_search_policy",
  "openseek_desktop/file_search_score",
  "openseek_desktop/backend/internal/gitx",
  "openseek_desktop/backend/moonbit",
  "openseek_desktop/backend/pathx",
  "openseek_desktop/protocol",
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/process",
  "moonbitlang/core/async/semaphore",
  "moonbitlang/core/buffer",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
}

warnings = "+test_unqualified_package+unnecessary_annotation+unnecessary_view_op+ambiguous_range_direction+unqualified_local_using"

supported_targets = "+native"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
    "moonbitlang/core/async/process",
    "moonbitlang/core/async/semaphore",
  ],
)
