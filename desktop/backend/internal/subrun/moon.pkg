import {
  "openseek_desktop/backend/pathx",
  "openseek_desktop/protocol",
  "openseek_desktop/backend/internal/session_record",
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/cmp",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
}

import {
  "openseek_desktop/backend/internal/fsx",
} for "wbtest"

warnings = "+test_unqualified_package+unnecessary_annotation+unnecessary_view_op+ambiguous_range_direction+unqualified_local_using"

supported_targets = "+native+wasm"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
  ],
)
