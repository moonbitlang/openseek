import {
  "moonbitlang/openseek/env" @executable,
  "moonbitlang/x/path",
  "openseek_desktop/backend/api",
  "openseek_desktop/backend/mcp",
  "openseek_desktop/backend/remote",
  "openseek_desktop/backend/host",
  "moonbitlang/core/async",
  "moonbitlang/core/async/stdio",
  "moonbitlang/core/env",
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/stdio",
  ],
)
