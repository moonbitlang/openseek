  #|     + "-" + pad(now.getUTCHours(), 2) + pad(now.getUTCMinutes(), 2)
  #|     + pad(now.getUTCSeconds(), 2)
  #|     + "-" + pad(now.getUTCMilliseconds(), 3);
  #| }
