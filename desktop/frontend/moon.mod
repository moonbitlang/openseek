name = "openseek_desktop/frontend"

version = "0.1.5"

import {
  "moonbitlang/openseek_protocol@0.4.1",
  "moonbit-community/cmark@0.4.11",
  "moonbit-community/fuzzy_match@0.2.6",
  "moonbit-community/rabbita@0.16.7",
  "Lampese/office-viewer@0.2.6",
  "moonbitlang/editor@0.4.6",
  "moonbitlang/x@0.5.5",
  "moonbitlang/openseek@0.7.3",
  "openseek_desktop@0.1.5",
  "moonbitlang/async@0.22.4",
  "Lampese/mathplotlib@0.18.0",
}

license = "Apache-2.0"

description = "SeekMoon browser frontend for the OpenSeek desktop client."

warnings = "+implicit_impl_as_method+test_unqualified_package"

preferred_target = "js"

supported_targets = "js"
