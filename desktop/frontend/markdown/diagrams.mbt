///|
/// DOM-bound diagram renderers for transcript Markdown.
/// Diagrams compile only when a source/container changes, never on unrelated
/// Rabbita view updates.
priv enum MarkdownDiagramRenderer {
  /// A Diago or UML render; disposing it stops a late result from writing
  /// into a replaced container.
  Compiled(@diagrams.PendingDiagram)
  Mermaid(@editor_viewer.MermaidDiagram)
}

///|
priv struct MarkdownDiagram {
  element : @dom.Element
  source : String
  language : String
  renderer : MarkdownDiagramRenderer
  mut dark_mode : Bool
}

///|
fn MarkdownDiagram::dispose(self : Self) -> Unit {
  match self.renderer {
    Compiled(render) => render.dispose()
    Mermaid(diagram) => diagram.dispose()
  }
}

///|
pub fn DiagramRenderers::refresh(
  self : Self,
  root : @dom.Element,
  dark_mode~ : Bool,
) -> Unit {
  let elements = root.query_selector_all("[data-transcript-diagram]")
  let retained : Array[MarkdownDiagram] = []
  // Dispose removed/reused targets first, invalidating their pending Mermaid
  // work before any new diagram is installed into the same container.
  for entry in self.rendered {
    if elements
      .iter()
      .any(element => {
        entry.element.is_same_node(element.as_node()) &&
        element.get_attribute("data-transcript-diagram-source") is Some(source) &&
        source == entry.source &&
        element.get_attribute("data-transcript-diagram") is Some(language) &&
        language == entry.language
      }) {
      retained.push(entry)
    } else {
      entry.dispose()
    }
  }
  for element in elements {
    guard element.get_attribute("data-transcript-diagram-source")
      is Some(source) &&
      element.get_attribute("data-transcript-diagram") is Some(language) else {
      continue
    }
    let existing = for entry in retained {
      if entry.element.is_same_node(element.as_node()) {
        break Some(entry)
      }
    } nobreak {
      None
    }
    if existing is Some(entry) {
      if entry.dark_mode != dark_mode {
        entry.dark_mode = dark_mode
        match entry.renderer {
          Compiled(_) => ()
          Mermaid(diagram) => diagram.set_dark_mode(dark_mode)
        }
      }
    } else {
      let renderer = if language == "mermaid" {
        MarkdownDiagramRenderer::Mermaid(
          @editor_viewer.MermaidDiagram(
            element,
            source,
            dark_mode~,
            on_size_changed=self.on_size_changed,
          ),
        )
      } else if @diagrams.DiagramKind::from_fence(language) is Some(kind) {
        self.compile(element, source, kind)
      } else {
        continue
      }
      retained.push({ element, source, language, dark_mode, renderer, })
    }
  }
  self.rendered = retained
}

///|
/// Replaces the source fallback only on successful compilation, with SVG
/// generated by the diagram renderer rather than source-supplied HTML.
fn DiagramRenderers::compile(
  self : Self,
  element : @dom.Element,
  source : String,
  kind : @diagrams.DiagramKind,
) -> MarkdownDiagramRenderer {
  let wrapper_class = match kind {
    Uml => "chat-markdown-diagram moonbit-viewer-markdown-diagram"
    _ => "moonbit-viewer-markdown-diagram"
  }
  let render = @diagrams.render(kind, source, svg => {
    guard svg is Some(svg) else { return }
    element.set_inner_html(
      "<div class=\"\{wrapper_class}\" data-diagram-language=\"\{kind.name()}\">\{svg}</div>",
    )
    (self.on_size_changed)()
  })
  Compiled(render)
}

///|
pub struct DiagramRenderers {
  priv mut rendered : Array[MarkdownDiagram]
  priv on_size_changed : () -> Unit
}

///|
pub fn DiagramRenderers::DiagramRenderers(on_size_changed : () -> Unit) -> Self {
  { rendered: [], on_size_changed, }
}

///|
pub fn DiagramRenderers::dispose(self : Self) -> Unit {
  for entry in self.rendered {
    entry.dispose()
  }
  self.rendered = []
}
