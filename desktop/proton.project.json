{
  "identifier": "community.moonbit.proton.openseek-desktop",
  "backend": {
    "path": "app",
    "package": "."
  },
  "package": {
    "product_name": "SeekMoon",
    "version": "0.1.5",
    "formats": ["app", "zip"],
    "icons": [
      "package/macos/AppIcon.icns",
      "package/windows/AppIcon.ico",
      "package/linux/appicon.png"
    ],
    "resources": ["seekmoon/**"],
    "output": "dist"
  },
  "platforms": {
    "macos": {
      "package": {
        "sign": {
          "binaries": ["seekmoon/**"]
        }
      }
    }
  }
}
