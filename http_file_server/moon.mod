name = "moonbitlang/http_file_server"

version = "0.1.0"

import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/x@0.5.5",
}

readme = "README.md"

repository = "https://github.com/moonbitlang/openseek"

license = "Apache-2.0"

description = "Confined static HTTP file responses and a loopback CLI for MoonBit."

preferred_target = "native"

supported_targets = "native"

warnings = "+implicit_impl_as_method+test_unqualified_package"
