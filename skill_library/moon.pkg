import {
  "moonbit-community/flate/checksum",
  "moonbit-community/flate/zip",
  "moonbit-community/skills/skills" @registry,
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/os_error",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/openseek/agent_skill",
  "moonbitlang/x/path",
}

import {
  "moonbitlang/core/async/http",
  "moonbitlang/core/async/socket",
  "moonbitlang/x/crypto",
} for "wbtest"

warnings = "+missing_doc+test_unqualified_package+unnecessary_annotation+unnecessary_view_op+ambiguous_range_direction+unqualified_local_using"

supported_targets = "+native+wasm"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
    "moonbitlang/core/async/http",
    "moonbitlang/core/async/os_error",
    "moonbitlang/core/async/socket",
  ],
)
