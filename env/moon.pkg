import {
  "moonbitlang/core/async/os_error",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x/path",
}

import {
  "moonbitlang/core/env" @sys,
} for "test"

supported_targets = "+native+wasm"

options(
  "allow-experimental-packages": [ "moonbitlang/core/async/os_error" ],
  targets: { "env_native.mbt": [ "native" ], "env_wasm.mbt": [ "wasm" ] },
)
