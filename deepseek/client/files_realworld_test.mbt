///|
/// Exercise the real Files API and image interpretation together. The fixture
/// is a complete 256x128 RGB PNG (blue left half, yellow right half), embedded
/// to make the test independent of its working directory. Neither the prompt
/// nor the upload filename discloses the expected colors. The upload expires
/// after one hour so running this smoke test does not create permanent files.
async test "realworld DeepSeek image upload and recognition" {
  guard @env.get_env_var("DEEPSEEK") is Some(api_key) && api_key != "" else {
    println(
      "DEEPSEEK is not set; skipping realworld image upload and recognition",
    )
    return
  }
  let image = b"\x89\x50\x4e\x47\x0d\x0a\x1a\x0a\x00\x00\x00\x0d\x49\x48\x44\x52\x00\x00\x01\x00\x00\x00\x00\x80\x08\x02\x00\x00\x00\x6b\xd7\x20\x5d\x00\x00\x01\x8f\x49\x44\x41\x54\x78\xda\xed\xd3\x41\x0d\x00\x30\x10\xc3\xb0\xf0\x27\xdd\xc1\xb8\x3d\x2c\x05\x42\x5c\x4d\x87\x6d\xe9\xb0\x2c\x08\x00\x00\x02\x00\x00\x01\x00\x80\x00\x00\x40\x00\x00\x20\x00\x00\x10\x00\x00\x08\x00\x00\x04\x00\x00\x02\x00\x00\x01\x00\x80\x00\x00\x40\x00\x00\x20\x00\x00\x10\x00\x00\x08\x00\x00\x04\x00\x00\x02\x00\x00\x01\x00\x80\x00\x00\x40\x00\x00\x20\x00\x00\x10\x00\x00\x08\x00\x00\x04\x00\x00\x02\x00\x00\x00\x04\x00\x00\x02\x00\x00\x01\x00\x80\x00\x00\x40\x00\x00\x20\x00\x00\x10\x00\x00\x08\x00\x00\x04\x00\x00\x02\x00\x00\x01\x00\x80\x00\x00\x40\x00\x00\x20\x00\x00\x10\x00\x00\x08\x00\x00\x04\x00\x00\x02\x00\x00\x01\x00\x80\x00\x00\x40\x00\x00\x20\x00\x00\x10\x00\x00\x08\x00\x00\x04\x00\x00\x00\xb8\x10\x00\x00\x04\x00\x00\x02\x00\x00\x01\x00\x80\x00\x00\x40\x00\x00\x20\x00\x00\x10\x00\x00\x08\x00\x00\x04\x00\x00\x02\x00\x00\x01\x00\x80\x00\x00\x40\x00\x00\x20\x00\x00\x10\x00\x00\x08\x00\x00\x04\x00\x00\x02\x00\x00\x01\x00\x80\x00\x00\x40\x00\x00\x20\x00\x00\x10\x00\x00\x08\x00\x00\x00\x70\x21\x00\x00\x08\x00\x00\x04\x00\x00\x02\x00\x00\x01\x00\x80\x00\x00\x40\x00\x00\x20\x00\x00\x10\x00\x00\x08\x00\x00\x04\x00\x00\x02\x00\x00\x01\x00\x80\x00\x00\x40\x00\x00\x20\x00\x00\x10\x00\x00\x08\x00\x00\x04\x00\x00\x02\x00\x00\x01\x00\x80\x00\x00\x40\x00\x00\x20\x00\x00\x10\x00\x00\x08\x00\x00\x00\x10\x00\x00\x08\x00\x00\x04\x00\x00\x02\x00\x00\x01\x00\x80\x00\x00\x40\x00\x00\x20\x00\x00\x10\x00\x00\x08\x00\x00\x04\x00\x00\x02\x00\x00\x01\x00\x80\x00\x00\x40\x00\x00\x20\x00\x00\x10\x00\x00\x08\x00\x00\x04\x00\x00\x02\x00\x00\x01\x00\x80\x00\x00\x40\x00\xfc\xd3\x03\x8e\xa7\x4b\x32\x32\x8c\x29\xd4\x00\x00\x00\x00\x49\x45\x4e\x44\xae\x42\x60\x82"
  // The Vision API documents deepseek-flash, represented by V41Flash.
  let client = @client.Client(
    api_key~,
    model=Deepseek(V41Flash),
    retry_attempts=1,
  )
  @async.with_timeout(120_000, () => {
    let uploaded = client.upload_image(
      image,
      filename="fixture.png",
      expires_after_seconds=3600,
      timeout_ms=60_000,
    )
    assert_false(uploaded.id.is_blank())
    assert_eq(uploaded.bytes, image.length().to_int64())
    assert_true(uploaded.expires_at is Some(_))
    let response = client.chat(
      [
        ChatMessage(User, content=[
          Text(
            text="Identify the solid color of each half of this image. Reply only with a JSON object with keys left and right, using one lowercase English color name for each.",
          ),
          File(file_id=uploaded.id),
        ]),
      ],
      response_format=JsonObject,
    )
    let answer = @json.parse(response.content)
    guard answer is { "left": "blue", "right": "yellow", .. } else {
      fail("unexpected image recognition response: \{response.content}")
    }
    assert_true(response.usage.total_tokens > 0)
  })
}
