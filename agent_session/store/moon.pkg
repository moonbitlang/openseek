import {
  "moonbitlang/openseek/attachments",
  "moonbitlang/openseek_protocol" @protocol,
  "moonbitlang/openseek/internal/workspace_path",
  "moonbitlang/openseek/agent_session",
  "moonbitlang/openseek/agent_session/log" @session_log,
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/os_error",
  "moonbitlang/core/encoding/hex",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x/crypto",
  "moonbitlang/core/env",
  "moonbitlang/core/immut/vector",
  "moonbitlang/core/json",
}

import {
  "moonbitlang/openseek/testkit/filesystem" @vfs,
  "moonbitlang/openseek/deepseek/client",
  "moonbitlang/core/async/http",
  "moonbitlang/core/async/socket",
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
} for "test"

warnings = "+unnecessary_annotation"

supported_targets = "+wasm+native"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
    "moonbitlang/core/async/http",
    "moonbitlang/core/async/os_error",
    "moonbitlang/core/async/socket",
  ],
)
