import {
  "moonbitlang/core/env",
  "moonbitlang/openseek/agent_approval",
  "moonbitlang/openseek/agent_explore",
  "moonbitlang/openseek/agent_worker",
  "moonbitlang/openseek/agent_review",
  "moonbitlang/openseek/agent_tool/subagent",
  "moonbitlang/openseek/agent_runtime",
  "moonbitlang/openseek/agent_session",
  "moonbitlang/openseek/agent_skill",
  "moonbitlang/openseek/agent_subrun",
  "moonbitlang/openseek/agent_tool",
  "moonbitlang/openseek/mcp/host" @mcphost,
  "moonbitlang/core/async/aqueue",
  "moonbitlang/core/argparse",
  "moonbitlang/core/async",
  "moonbitlang/openseek/deepseek",
  "moonbitlang/openseek_protocol/emit",
  "moonbitlang/openseek_protocol" @protocol,
  "moonbitlang/openseek/cli",
  "moonbitlang/core/async/stdio",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/json",
  "moonbitlang/openseek/mcp/config" @mcpconfig,
  "moonbitlang/openseek/mcp/tools" @mcptools,
  "moonbitlang/openseek/internal/openseek/setup",
  "moonbitlang/openseek/agent_tool/web_search",
  "moonbitlang/workflow/spawn",
  "moonbitlang/openseek/internal/which",
}

import {
  "moonbitlang/openseek/internal/openseek/testkit",
  "moonbitlang/core/async/http",
  "moonbitlang/core/async/socket",
} for "test"

warnings = "+unnecessary_annotation"

supported_targets = "+wasm+native"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/aqueue",
    "moonbitlang/core/async/fs",
    "moonbitlang/core/async/http",
    "moonbitlang/core/async/socket",
    "moonbitlang/core/async/stdio",
  ],
)
