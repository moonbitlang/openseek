import {
  "moonbitlang/openseek/agent_session",
  "moonbitlang/openseek/agent_session/log" @session_log,
  "moonbitlang/openseek/deepseek",
  "moonbitlang/openseek/eval/internal/metrics",
  "moonbitlang/openseek/eval/internal/runner",
  "moonbitlang/openseek/eval/report",
  "moonbitlang/openseek/eval/session_analyzer",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

import {
  "moonbitlang/openseek/testkit/filesystem" @vfs,
  "moonbitlang/core/async",
} for "wbtest"

warnings = "+unnecessary_annotation"

supported_targets = "+native"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
    "moonbitlang/core/async/process",
  ],
)
