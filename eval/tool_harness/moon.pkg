import {
  "moonbitlang/openseek/agent_runtime",
  "moonbitlang/openseek/agent_tool",
  "moonbitlang/openseek/agent_tool/edit",
  "moonbitlang/openseek/agent_tool/finish",
  "moonbitlang/openseek/agent_tool/multi_edit",
  "moonbitlang/openseek/agent_tool/plan",
  "moonbitlang/openseek/agent_tool/mbtx",
  "moonbitlang/openseek/agent_tool/write",
  "moonbitlang/openseek/deepseek",
  "moonbitlang/openseek/eval/report",
  "moonbitlang/openseek/testkit/filesystem" @vfs,
  "moonbitlang/core/async/fs",
}

import {
  "moonbitlang/core/async",
} for "test"

warnings = "+unnecessary_annotation"

supported_targets = "+native"
// Each harness run builds an mbtx snippet; serialize the test and doc cases
// so they do not compete with one another for the compiler's build budget.

max_concurrent_tests = 1

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
  ],
)
