///|
/// The JSON a trial result writes into `report.json`, pinned byte for byte.
test "trial results serialize to their pinned shape" {
  let result : TrialResult = {
    index: 2,
    case_id: "c",
    prompt_label: "l",
    success: true,
    reason: "ok",
    workspace: "ws",
    log_path: "log",
    exit_code: 0,
    steps: 3,
    tool_errors: 4,
    moon_run_e_mentions: 5,
    moon_run_c_mentions: 6,
    moon_check_uses: 7,
    moon_test_uses: 8,
    moon_info_uses: 9,
    moon_fmt_uses: 10,
    edit_successes: 11,
    write_successes: 12,
    validation_passed: true,
    marker_present: false,
    warnings: "w",
  }
  json_inspect(ToJson::to_json(result), content={
    "index": 2,
    "case_id": "c",
    "prompt_label": "l",
    "success": true,
    "reason": "ok",
    "workspace": "ws",
    "log_path": "log",
    "exit_code": 0,
    "steps": 3,
    "tool_errors": 4,
    "moon_run_e_mentions": 5,
    "moon_run_c_mentions": 6,
    "moon_check_uses": 7,
    "moon_test_uses": 8,
    "moon_info_uses": 9,
    "moon_fmt_uses": 10,
    "edit_successes": 11,
    "write_successes": 12,
    "validation_passed": true,
    "marker_present": false,
    "warnings": "w",
  })
}
