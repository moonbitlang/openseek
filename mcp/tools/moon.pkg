import {
  "moonbitlang/openseek/agent_tool",
  "moonbitlang/openseek/agent_runtime",
  "moonbitlang/openseek/mcp",
  "moonbitlang/openseek/mcp/stdio",
  "moonbitlang/openseek/mcp/streamhttp",
  "moonbitlang/openseek/mcp/config",
  "moonbitlang/openseek/mcp/config/headers_helper",
  "moonbitlang/openseek_protocol/emit",
  "moonbitlang/core/async",
}

import {
  "moonbitlang/openseek/mcp/host" @mcphost,
  "moonbitlang/openseek/jsonrpc",
  "moonbitlang/openseek/agent_runtime",
  "moonbitlang/openseek/mcp/config",
  "moonbitlang/core/async",
  "moonbitlang/core/async/http",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/socket",
  "moonbitlang/core/json",
} for "test"

supported_targets = "+wasm+native"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
    "moonbitlang/core/async/http",
    "moonbitlang/core/async/socket",
  ],
)
