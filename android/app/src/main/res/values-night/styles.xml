<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- WebView reports prefers-color-scheme from this theme's isLightTheme, so
         the frontend's System appearance follows Android's night mode. The
         background matches the frontend's dark theme-color. -->
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#4263EB</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#16181D</item>
    </style>
</resources>
