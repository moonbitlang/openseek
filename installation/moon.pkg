import {
  "moonbitlang/openseek/env" @exe,
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/os_error",
  "moonbitlang/core/async/process",
  "moonbitlang/core/async/stdio",
  "moonbitlang/core/env",
  "moonbitlang/x/path",
}

supported_targets = "+native+wasm"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
    "moonbitlang/core/async/os_error",
    "moonbitlang/core/async/process",
    "moonbitlang/core/async/stdio",
  ],
)
