import {
  "moonbitlang/openseek/agent_session",
  "moonbitlang/openseek/agent_session/log" @session_log,
  "moonbitlang/openseek/viz",
  "moonbit-community/rabbita",
  "moonbit-community/rabbita/dom",
  "moonbit-community/rabbita/html",
  "moonbit-community/rabbita/cmd",
  "moonbit-community/rabbita/http",
  "moonbit-community/rabbita/nav",
  "moonbit-community/rabbita/sub",
  "moonbit-community/rabbita/url",
  "moonbitlang/core/cmp",
  "moonbit-community/rabbita/js",
  "moonbitlang/core/encoding/percent",
  "moonbitlang/core/json",
}

import {
  "moonbitlang/core/debug",
} for "wbtest"

warnings = "+unnecessary_annotation"

supported_targets = "js"

pkgtype(kind: "executable")
