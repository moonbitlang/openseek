  "moonbitlang/openseek/agent_tool/web_search",
  "moonbitlang/openseek/mcp/config" @mcpconfig,
  "moonbitlang/openseek/mcp/tools" @mcptools,
  "moonbitlang/core/json",
  "moonbitlang/openseek/agent_skill",
  "moonbitlang/openseek/agent_session",
