import {
  "bobzhang/openseek/internal/workspace_path",
  "moonbitlang/async/fs",
}

import {
  "bobzhang/openseek/testkit/filesystem" @vfs,
  "moonbitlang/async",
} for "test"

// test-scope-only imports (@vfs/@async) are used only by tests that are
// Windows-excluded, so they are legitimately unused under the Windows
// check; disable unused_package rather than dropping imports the Linux
// tests need.

warnings = "+unnecessary_annotation-unused_package"

supported_targets = "+native"
