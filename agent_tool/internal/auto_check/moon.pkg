import {
  "moonbitlang/openseek/agent_tool/internal/manifest_path",
  "moonbitlang/openseek/agent_tool/internal/moon_check",
  "moonbitlang/openseek/internal/workspace_path",
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/process",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

import {
  "moonbitlang/openseek/testkit/filesystem" @vfs,
} for "test"

warnings = "+unnecessary_annotation"

supported_targets = "+wasm+native"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
    "moonbitlang/core/async/process",
  ],
)
