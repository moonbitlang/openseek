import {
  "moonbitlang/openseek/agent_tool/internal/permission",
  "moonbitlang/openseek/agent_runtime",
  "moonbitlang/x/crypto",
  "moonbitlang/openseek/agent_tool",
  "moonbitlang/openseek/agent_tool/internal/auto_check",
  "moonbitlang/openseek/agent_tool/internal/error" @tool_error,
  "moonbitlang/openseek/agent_tool/write_scope",
  "moonbitlang/openseek/agent_tool/remove/internal/decode",
  "moonbitlang/openseek/internal/workspace_path",
  "moonbitlang/core/async/fs",
}

import {
  "moonbitlang/openseek/testkit/filesystem" @vfs,
  "moonbitlang/core/async",
} for "test"

warnings = "+unnecessary_annotation"

supported_targets = "+wasm+native"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
  ],
)
