import {
  "moonbitlang/openseek/agent_tool",
  "moonbitlang/openseek/agent_tool/bgjobs",
  "moonbitlang/openseek/agent_tool/internal/error" @tool_error,
  "moonbitlang/openseek/agent_tool/internal/sandbox",
  "moonbitlang/openseek/agent_tool/job_output/internal/decode",
  "moonbitlang/openseek/agent_subagent",
  "moonbitlang/openseek_protocol" @protocol,
}

import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/process",
} for "test"

supported_targets = "+wasm+native"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
    "moonbitlang/core/async/process",
  ],
)
