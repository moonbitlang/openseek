          #|      resolved_roots,
          #|      skipped_watermarked,
          #|      skipped_subagents,
          #|      warnings,
          #|      as_json~,
          #|    )
          #|    return
          #|  }
          #|  if selected.is_empty() && focus.is_empty() && !force {
          #|    output_nothing_to_do(
          #|      resolved_roots,
          #|      skipped_watermarked,
          #|      skipped_subagents,
          #|      warnings,
          #|      as_json~,
          #|    )
