import {
  "moonbitlang/openseek/agent_tool/ptc",
  "moonbitlang/openseek/mcp/host" @mcphost,
  "moonbitlang/openseek/agent_tool/internal/uuid",
  "moonbitlang/openseek/agent_tool",
  "moonbitlang/openseek/agent_tool/write_scope",
  "moonbitlang/openseek/agent_tool/bgjobs",
  "moonbitlang/openseek/agent_runtime",
  "moonbitlang/openseek/agent_tool/mbtx/internal/decode",
  "moonbitlang/openseek/agent_tool/internal/error" @tool_error,
  "moonbitlang/openseek/agent_tool/internal/sandbox",
  "moonbitlang/openseek/internal/workspace_path",
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/process",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/async/os_error",
}

rule(name: "agent_guide", command: "moonx $input \"$output\"")

dev_build(
  rule: "agent_guide",
  input: [
    "../../scripts/agent_guide.mbtx",
    "../../prompt/guides/artifacts.md",
    "../../prompt/guides/diagrams.md",
    "../../prompt/guides/diagrams/charts.md",
    "../../prompt/guides/diagrams/diago.md",
    "../../prompt/guides/diagrams/katex.md",
    "../../prompt/guides/diagrams/mermaid.md",
    "../../prompt/guides/diagrams/plantuml.md",
    "../../prompt/guides/git-shipping.md",
    "../../prompt/guides/mcp.md",
    "../../prompt/guides/moonbit-development.md",
    "../../prompt/guides/moongrep.md",
    "../../prompt/guides/presentation.md",
    "../../prompt/guides/slides/design.md",
    "../../prompt/guides/slides/typst-layout.md",
    "../../prompt/guides/slides/typst-syntax-cautions.md",
    "../../prompt/guides/slides/typst-touying.md",
    "../../prompt/guides/slides/writing.md",
  ],
  output: "agent-guide.mbtx",
)

dev_build(
  rule: "mbtx_bundle",
  input: [
    "agent-guide.mbtx",
    "../../share/workflow/change-review.mbtx",
    "../../share/workflow/check-json.mbtx",
    "../../share/workflow/check-test.mbtx",
    "../../share/workflow/check.mbtx",
    "../../share/workflow/ci-watch.mbtx",
    "../../share/workflow/dream.mbtx",
    "../../share/workflow/fix-deprecations.mbtx",
    "../../share/workflow/fmt.mbtx",
    "../../share/workflow/ide.mbtx",
    "../../share/workflow/ls.mbtx",
    "../../share/workflow/read.mbtx",
    "../../share/workflow/repo-map.mbtx",
    "../../share/workflow/review.mbtx",
    "../../share/workflow/rg.mbtx",
    "../../share/workflow/shrink.mbtx",
    "../../share/workflow/simplify.mbtx",
    "../../share/workflow/test.mbtx",
  ],
  output: "generated_bundled_workflows.mbt",
)

warnings = "+unnecessary_annotation"

supported_targets = "+wasm+native"

import {
  "moonbitlang/openseek/agent_tool/ptc",
  "moonbitlang/openseek/agent_tool/job_output",
  "moonbitlang/openseek/agent_tool/image",
  "moonbitlang/openseek_protocol",
  "moonbitlang/core/async",
  "moonbitlang/core/json",
  "moonbitlang/openseek/agent_runtime",
  "moonbitlang/openseek/agent_tool/bgjobs",
  "moonbitlang/openseek/testkit/filesystem" @vfs,
  "moonbitlang/openseek/agent_tool/edit",
  "moonbitlang/openseek/agent_tool/multi_edit",
  "moonbitlang/openseek/agent_tool/write",
  "moonbitlang/openseek/agent_tool/remove",
} for "test"

import {
  "moonbitlang/openseek/testkit/filesystem" @vfs,
} for "wbtest"
// Every test here compiles and runs a real snippet through `moon`, and the
// tool bounds that BUILD phase at 20s. Run unbounded, dozens of toolchain
// builds compete for the same machine and the slower ones — the snippets
// that import `moonbitlang/async` — cross that deadline, so the suite fails
// on contention rather than on behaviour. Two at a time keeps every build
// inside the budget on both backends, and the suite finishes faster for it.

max_concurrent_tests = 2

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
    "moonbitlang/core/async/os_error",
    "moonbitlang/core/async/process",
  ],
)
