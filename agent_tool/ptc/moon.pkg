import {
  "moonbitlang/openseek/agent_tool/bgjobs",
  "moonbitlang/openseek_protocol" @protocol,
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/os_error",
  "moonbitlang/openseek/agent_tool/internal/uuid",
  "moonbitlang/openseek/agent_tool",
  "moonbitlang/openseek/internal/loopback_http",
  "moonbitlang/core/async",
  "moonbitlang/core/async/http",
  "moonbitlang/core/async/socket",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x/crypto",
}

supported_targets = "+wasm+native"

import {
  "moonbitlang/core/json",
} for "wbtest"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
    "moonbitlang/core/async/http",
    "moonbitlang/core/async/os_error",
    "moonbitlang/core/async/socket",
  ],
)
